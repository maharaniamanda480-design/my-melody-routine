<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:padding="12dp" android:background="#FFFFF8FB">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/bunny_icon" android:contentDescription="Bunny" />
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="My Melody Daily ♡" android:textColor="#A94770" android:textStyle="bold" android:textSize="16sp" />
   <TextView android:id="@+id/progress_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 dari 24 selesai · 0%" android:textColor="#986B80" android:textSize="11sp" />
  </LinearLayout>
  <TextView android:id="@+id/reset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="↻" android:textColor="#A94770" android:textSize="22sp" android:padding="5dp" />
 </LinearLayout>
 <ProgressBar android:id="@+id/progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="6dp" android:progressTint="#E879A4" android:progressBackgroundTint="#F8D5E2" android:max="24" android:progress="0" />
 <TextView android:id="@+id/page_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PAGI · 1/6" android:textColor="#B94F79" android:textStyle="bold" android:textSize="11sp" android:paddingTop="7dp" />
 <TextView android:id="@+id/task0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="□ Bangun tidur" android:textColor="#63384B" android:textSize="12sp" android:padding="2dp" />
 <TextView android:id="@+id/task1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="□ Sholat Subuh" android:textColor="#63384B" android:textSize="12sp" android:padding="2dp" />
 <TextView android:id="@+id/task2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="□ Membaca Al-Qur’an" android:textColor="#63384B" android:textSize="12sp" android:padding="2dp" />
 <TextView android:id="@+id/task3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="□ Belajar UTBK" android:textColor="#63384B" android:textSize="12sp" android:padding="2dp" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
  <TextView android:id="@+id/previous" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="‹ Sebelumnya" android:textColor="#B94F79" android:textSize="11sp" android:padding="5dp" />
  <TextView android:id="@+id/next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Berikutnya ›" android:textColor="#B94F79" android:textSize="11sp" android:padding="5dp" />
 </LinearLayout>
</LinearLayout>
